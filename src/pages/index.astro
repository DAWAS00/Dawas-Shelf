---
import Base from '../layouts/Base.astro';
import Library from '../components/Library.astro';
import HeroFilm from '../components/HeroFilm.astro';
import BrushButton from '../components/BrushButton.astro';
import InkStroke from '../components/InkStroke.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
const count = (await getCollection('resources')).length;
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy"><div class="hero-kicker"><span class="little-stroke"></span><span>Dawas’s collection for curious minds</span></div><h1 id="hero-title"><span class="hero-line"><span data-hero-line>Good tools.</span></span><span class="hero-line"><em data-hero-line>Clearer thinking.</em></span></h1><p class="hero-description">Useful websites, practical skills, and prompts worth keeping.<br class="desktop-break" /> A personal shelf for turning good ideas into things you make.</p><div class="hero-actions"><BrushButton href="#library">Explore the library <Icon name="arrow" size={20} /></BrushButton><span class="hero-note">Collected by Dawas.<br />Made to be used.</span></div><div class="hero-footnote"><span class="status-dot"></span>{count} resources &nbsp; / &nbsp; Always growing</div></div>
    <HeroFilm />
  </section>
  <div class="intention-strip container"><InkStroke /><p><Icon name="asterisk" size={24} /> Not everything. Just a thoughtful place to start.</p><a href="/about/">The idea behind the shelf <Icon name="arrow" size={17} /></a></div>
  <Library />
  <section class="closing-note container"><span class="eyebrow">A shelf that grows with us</span><h2>Found something good?<br /><em>Leave it on the shelf.</em></h2><p>A helpful tool, a skill you rely on, a prompt worth sharing. Send it to Dawas for a closer look.</p><a class="text-link" href="/contribute/">Suggest a resource <Icon name="arrow" size={20} /></a></section>
</Base>
