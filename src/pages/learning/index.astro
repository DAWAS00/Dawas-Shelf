---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import InkStroke from '../../components/InkStroke.astro';
const articles = (await getCollection('learning')).sort((a,b) => b.data.published.getTime() - a.data.published.getTime());
---
<Base title="Learning — Dawas Shlef" description="Reading guides, practical experiments, and notes for working thoughtfully with AI.">
  <section class="learning-home container">
    <span class="eyebrow">Read. Try. Make it your own.</span>
    <h1>A little understanding.<br /><em>A better starting point.</em></h1>
    <p class="learning-intro">Guides to the ideas behind the tools. Explore a lesson, try a small experiment, and bring what you learn into your work.</p>
    <div class="learning-list">
      {articles.map(article => <article class="learning-card">
        <div class="lesson-art" aria-hidden="true"><span>FIELD NOTES / 01</span><div>Ask clearly.<br /><em>Test thoughtfully.</em></div><InkStroke /><p>Context → Examples → Evidence</p></div>
        <div class="learning-card-copy"><span class="eyebrow">{article.data.category} · Reading guide</span><h2><a href={`/learning/${article.id}/`}>{article.data.title}</a></h2><p>{article.data.description}</p><div class="learning-meta"><span>By {article.data.author}</span><time datetime={article.data.published.toISOString()}>{article.data.published.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></div><a class="text-link" href={`/learning/${article.id}/`}>Read the guide <Icon name="arrow" size={20} /></a></div>
      </article>)}
    </div>
    <p class="learning-footnote">Independent reading notes, with credit and links to the original authors.</p>
  </section>
</Base>

