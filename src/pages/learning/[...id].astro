---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
export async function getStaticPaths() {
  return (await getCollection('learning')).map(article => ({ params: { id: article.id }, props: { article } }));
}
interface Props { article: CollectionEntry<'learning'>; }
const { article } = Astro.props;
const { Content, headings } = await render(article);
const words = article.body?.split(/\s+/).length || 0;
const minutes = Math.max(1, Math.ceil(words / 220));
---
<Base title={`${article.data.title} — Dawas Shlef`} description={article.data.description}>
  <article class="learning-article container">
    <a class="text-link" href="/learning/"><Icon name="back" size={18} /> All learning notes</a>
    <header class="learning-heading"><span class="eyebrow">{article.data.category} / A guide to the repository</span><h1>{article.data.title}</h1><p>{article.data.description}</p><div class="learning-meta"><span>By {article.data.author}</span><time datetime={article.data.published.toISOString()}>{article.data.published.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time><span>{minutes} min read</span></div></header>
    <div class="learning-article-layout">
      <aside class="learning-toc"><nav aria-label="In this guide"><span class="eyebrow">In this guide</span><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav><a class="text-link" href={article.data.source} target="_blank" rel="noopener noreferrer">Original tutorial <Icon name="external" size={16} /><span class="sr-only"> (opens in a new tab)</span></a><p>Source: {article.data.sourceLabel}<br />Independent notes by Dawas.</p></aside>
      <div class="prose learning-prose"><Content /><a class="text-link learning-return" href="/learning/"><Icon name="back" size={18} /> Back to learning</a></div>
    </div>
  </article>
</Base>

