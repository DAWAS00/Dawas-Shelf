    <path d="M158 354c-33-32-63-52-111-64M163 309c32-31 58-49 97-56M153 256c-32-31-48-51-62-80M154 225c24-19 47-28 76-30M167 404c34-15 63-18 90-17" stroke-width="2.6" />
  </g>
  <g fill="#4e6b5c">
    <path d="M54 292c-33-8-42-24-44-41 26 2 40 18 44 41ZM86 303c-16-27-14-48-4-62 16 22 18 42 4 62ZM108 319c-3-24 4-42 18-49 7 22 0 42-18 49ZM204 279c-2-30 9-47 29-53-1 24-10 41-29 53ZM224 263c19-21 39-25 57-17-16 20-35 25-57 17ZM115 218c-29-6-42-21-44-40 24 3 38 18 44 40ZM100 189c-13-25-10-42 1-55 13 22 12 40-1 55ZM184 209c7-29 20-42 39-41-8 26-22 40-39 41ZM211 198c20-13 40-12 53-1-19 13-36 14-53 1ZM150 161c-19-21-21-41-13-57 18 17 23 35 13 57ZM159 153c2-29 13-45 31-49-1 26-13 43-31 49ZM204 394c7-25 22-37 40-34-9 23-22 35-40 34ZM234 387c25-12 44-10 57 4-24 10-42 9-57-4Z" />
  </g>
  <g stroke="#23282a" stroke-width="1.7" stroke-linecap="round"><path d="m410 139 9-4 9 4m9-19 7-3 7 3m-71 43 6-3 6 3" /></g>
  <path d="M24 531c141-7 251-12 399-5" stroke="#6d8f7d" stroke-width="2" stroke-linecap="round" opacity=".35" />
</svg>
