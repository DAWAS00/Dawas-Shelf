---
interface Props { small?: boolean; }
const { small = false } = Astro.props;
const id = small ? 'small' : 'hero';
---
<svg class:list={['landscape', { small }]} viewBox="0 0 740 560" fill="none" aria-hidden="true">
  <defs>
    <filter id={`wash-${id}`}><feTurbulence baseFrequency=".012 .035" numOctaves="3" seed="11" result="noise" /><feDisplacementMap in="SourceGraphic" in2="noise" scale="14" /></filter>
    <linearGradient id={`mountain-${id}`} x1="300" y1="160" x2="400" y2="490" gradientUnits="userSpaceOnUse"><stop stop-color="#4e6b5c" stop-opacity=".6" /><stop offset="1" stop-color="#6d8f7d" stop-opacity="0" /></linearGradient>
    <linearGradient id={`fade-${id}`} x1="0" y1="100" x2="0" y2="550" gradientUnits="userSpaceOnUse"><stop stop-color="#6d8f7d" stop-opacity=".23" /><stop offset="1" stop-color="#f5f1e7" stop-opacity="0" /></linearGradient>
  </defs>
  <circle cx="510" cy="146" r="57" fill="#e9e3d5" />
  <g filter={`url(#wash-${id})`}>
    <path d="m80 351 73-72 41-10 46-53 35 13 56-82 48 51 40-20 69 77 44-15 87 116 91 35H80Z" fill={`url(#fade-${id})`} />
    <path d="m164 401 67-60 37-8 71-92 34 33 41-80 34 41 34 12 31 55 23-6 54 91 99 43Z" fill={`url(#mountain-${id})`} />
    <path d="m317 447 45-52 30 5 58-74 32 22 36-33 63 85 33 8 71 56Z" fill={`url(#fade-${id})`} />
  </g>
  <g stroke="#23282a" stroke-linecap="round">
