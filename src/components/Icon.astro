---
import arrow from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import external from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import search from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw';
import bookmark from '@phosphor-icons/core/assets/regular/bookmark-simple.svg?raw';
import bookmarkFilled from '@phosphor-icons/core/assets/fill/bookmark-simple-fill.svg?raw';
import copy from '@phosphor-icons/core/assets/regular/copy.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check.svg?raw';
import close from '@phosphor-icons/core/assets/regular/x.svg?raw';
import book from '@phosphor-icons/core/assets/regular/book-open.svg?raw';
import spark from '@phosphor-icons/core/assets/regular/sparkle.svg?raw';
import chevron from '@phosphor-icons/core/assets/regular/caret-right.svg?raw';
import back from '@phosphor-icons/core/assets/regular/arrow-left.svg?raw';
import instagram from '@phosphor-icons/core/assets/regular/instagram-logo.svg?raw';
import motion from '@phosphor-icons/core/assets/regular/circle-dashed.svg?raw';
import asterisk from '@phosphor-icons/core/assets/regular/asterisk-simple.svg?raw';
interface Props { name: string; size?: number; class?: string; }
const { name, size = 20, class: className = '' } = Astro.props;
const icons: Record<string, string> = { arrow, external, search, bookmark, copy, check, close, book, spark, chevron, back, instagram, motion, asterisk };
// Only trusted SVGs imported from the installed Phosphor package are inlined.
const content = (svg: string) => svg.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg class={className} width={size} height={size} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false" data-phosphor={name}>
  {name === 'bookmark' ? <><g class="bookmark-outline" set:html={content(bookmark)} /><g class="bookmark-filled" set:html={content(bookmarkFilled)} /></> : <Fragment set:html={content(icons[name] || arrow)} />}
</svg>
<style>
  .bookmark-filled { display: none; }
  :global([aria-pressed=true]) > svg .bookmark-outline { display: none; }
  :global([aria-pressed=true]) > svg .bookmark-filled { display: inline; }
</style>